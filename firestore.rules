rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isAdmin() { return exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }

    match /admins/{id} { allow read: if request.auth != null && request.auth.uid == id; allow write: if false; }
    match /books/{id} { allow read: if true; allow write: if isAdmin(); }
    match /bookFiles/{id} { allow read, write: if isAdmin(); }

    match /orders/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
    match /deliveries/{id} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
  }
}
